<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SystemTrayProcessManager.UI.Controls">

    <!-- Default Style for HotkeyCaptureBox -->
    <Style TargetType="{x:Type controls:HotkeyCaptureBox}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HotkeyCaptureBox}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Keyboard Icon -->
                            <TextBlock x:Name="KeyboardIcon"
                                       Grid.Column="0"
                                       Text="⌨️"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Opacity="0.6"/>

                            <!-- Display Text -->
                            <TextBlock x:Name="DisplayTextBlock"
                                       Grid.Column="1"
                                       Text="{TemplateBinding DisplayText}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       FontFamily="Segoe UI"
                                       FontSize="13"/>

                            <!-- Clear Button (when has value) -->
                            <Button x:Name="ClearButton"
                                    Grid.Column="2"
                                    Content="✕"
                                    FontSize="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,2"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    ToolTip="Clear hotkey"/>

                            <!-- Validation Indicator -->
                            <Ellipse x:Name="ValidationIndicator"
                                     Grid.Column="2"
                                     Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Margin="4,0"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Focus state -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                        </Trigger>

                        <!-- Capturing state -->
                        <Trigger Property="IsCapturing" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#FFFEF0"/>
                            <Setter TargetName="DisplayTextBlock" Property="FontStyle" Value="Italic"/>
                            <Setter TargetName="KeyboardIcon" Property="Opacity" Value="1"/>
                        </Trigger>

                        <!-- Has value -->
                        <Trigger Property="IsValid" Value="True">
                            <Setter TargetName="DisplayTextBlock" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="DisplayTextBlock" Property="Foreground" Value="#0078D4"/>
                            <Setter TargetName="ValidationIndicator" Property="Fill" Value="#28A745"/>
                            <Setter TargetName="ValidationIndicator" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Invalid state -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsValid" Value="False"/>
                                <Condition Property="VirtualKeyCode" Value="0"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="DisplayTextBlock" Property="Foreground" Value="#999999"/>
                        </MultiTrigger>

                        <!-- Invalid with value -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsValid" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ValidationIndicator" Property="Fill" Value="#DC3545"/>
                            <Setter TargetName="ValidationIndicator" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                            <Setter TargetName="Border" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
