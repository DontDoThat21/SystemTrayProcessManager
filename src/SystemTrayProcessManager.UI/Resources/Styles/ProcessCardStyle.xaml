<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SystemTrayProcessManager.UI.ViewModels"
                    xmlns:views="clr-namespace:SystemTrayProcessManager.UI.Views"
                    xmlns:converters="clr-namespace:SystemTrayProcessManager.UI.Converters">

    <!-- Local converter instances (needed because StaticResource cannot resolve
         resources defined in the parent App.xaml ResourceDictionary from a MergedDictionary) -->
    <views:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <converters:BoolToMuteIconConverter x:Key="BoolToMuteIconConverter"/>

    <!-- ============================================ -->
    <!-- ProcessCard DataTemplate                     -->
    <!-- Displays process icon, name, PID, and        -->
    <!-- quick action buttons with hover animations   -->
    <!-- ============================================ -->

    <DataTemplate x:Key="ProcessCardTemplate" DataType="{x:Type vm:ProcessCardViewModel}">
        <Border x:Name="CardBorder"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="4"
                MinWidth="280"
                MaxWidth="400"
                Cursor="Hand"
                RenderTransformOrigin="0.5,0.5"
                SnapsToDevicePixels="True">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Process Icon -->
                <Border Grid.Column="0" 
                        Width="40" Height="40" 
                        CornerRadius="4"
                        Background="{DynamicResource SurfaceBrush}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" 
                           Width="32" Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Border>

                <!-- Process Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}" 
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource FontSizeNormal}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayName}"/>
                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0">
                        <Run Text="PID:"/>
                        <Run Text="{Binding ProcessId, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding WindowTitle}" 
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200"
                               Margin="0,1,0,0"
                               Visibility="{Binding WindowTitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel x:Name="ActionButtons" 
                            Grid.Column="2" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Opacity="0">
                    
                    <!-- Bring to Front -->
                    <Button Style="{DynamicResource IconButtonStyle}"
                            Command="{Binding BringToFrontCommand}"
                            ToolTip="Bring to Front"
                            FontFamily="Segoe UI Symbol"
                            Content="&#x2B1A;"
                            Width="28" Height="28"
                            Margin="0,0,2,0"/>

                    <!-- Mute/Unmute -->
                    <Button Style="{DynamicResource IconButtonStyle}"
                            Command="{Binding ToggleMuteCommand}"
                            ToolTip="{Binding IsMuted, Converter={StaticResource BoolToMuteIconConverter}}"
                            FontFamily="Segoe UI Symbol"
                            Width="28" Height="28"
                            Margin="0,0,2,0">
                        <TextBlock Text="{Binding IsMuted, Converter={StaticResource BoolToMuteIconConverter}}"
                                   FontSize="14"/>
                    </Button>

                    <!-- Minimize -->
                    <Button Style="{DynamicResource IconButtonStyle}"
                            Command="{Binding MinimizeCommand}"
                            ToolTip="Minimize"
                            Content="&#x2015;"
                            FontFamily="Segoe UI Symbol"
                            Width="28" Height="28"
                            Margin="0,0,2,0"/>

                    <!-- Close -->
                    <Button Style="{DynamicResource IconButtonDangerStyle}"
                            Command="{Binding CloseCommand}"
                            ToolTip="Close"
                            Content="&#x2715;"
                            FontFamily="Segoe UI Symbol"
                            Width="28" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hover Triggers -->
        <DataTemplate.Triggers>
            <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.01" Duration="0:0:0.15"
                                             EasingFunction="{StaticResource QuadEase}"/>
                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.01" Duration="0:0:0.15"
                                             EasingFunction="{StaticResource QuadEase}"/>
                            <DoubleAnimation Storyboard.TargetName="ActionButtons"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.0" Duration="0:0:0.15"
                                             EasingFunction="{StaticResource QuadEase}"/>
                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.0" Duration="0:0:0.15"
                                             EasingFunction="{StaticResource QuadEase}"/>
                            <DoubleAnimation Storyboard.TargetName="ActionButtons"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
