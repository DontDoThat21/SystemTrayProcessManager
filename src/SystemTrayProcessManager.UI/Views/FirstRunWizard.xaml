<Window x:Class="SystemTrayProcessManager.UI.Views.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Welcome to SystemTray Process Manager"
        Height="420" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Content Area -->
        <TabControl x:Name="WizardPages"
                    Grid.Row="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,0,0,16">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Page 1: Welcome -->
            <TabItem>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Welcome!"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="SystemTray Process Manager"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,24"/>

                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="13" MaxWidth="400" LineHeight="22">
                        Manage your running processes with global hotkeys, per-process audio control, and advanced window manipulation -- all from the system tray.
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <!-- Page 2: Hotkey Setup -->
            <TabItem>
                <StackPanel VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Hotkey Setup"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,16"/>

                    <CheckBox x:Name="EnableHotkeysCheck"
                              Content="Enable global hotkeys"
                              IsChecked="True"
                              Foreground="{DynamicResource ForegroundBrush}"
                              Margin="0,8"
                              FontSize="14"/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="12" Margin="0,8,0,0">
                        Global hotkeys let you control processes from any application.
                        You can customize bindings later in the Hotkey Configuration window.
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="12" Margin="0,12,0,0">
                        Default hotkeys:
                    </TextBlock>

                    <StackPanel Margin="16,8,0,0">
                        <TextBlock Text="Ctrl+Alt+M  -  Toggle mute (focused app)"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12" Margin="0,2"/>
                        <TextBlock Text="Ctrl+Alt+N  -  Minimize window"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12" Margin="0,2"/>
                        <TextBlock Text="Ctrl+Alt+B  -  Bring to front"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12" Margin="0,2"/>
                        <TextBlock Text="Ctrl+Alt+Shift+W  -  Close window"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12" Margin="0,2"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Page 3: Permissions -->
            <TabItem>
                <StackPanel VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="Permissions"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Margin="0,0,0,16"/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="13" LineHeight="22">
                        This application works best with standard user permissions. However, some features may require administrator privileges:
                    </TextBlock>

                    <StackPanel Margin="16,12,0,0">
                        <TextBlock Text="- Managing elevated (admin) processes"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12" Margin="0,4"/>
                        <TextBlock Text="- Adjusting process CPU priorities"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12" Margin="0,4"/>
                        <TextBlock Text="- Starting with Windows (registry)"
                                   Foreground="{DynamicResource ForegroundBrush}" FontSize="12" Margin="0,4"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="12" Margin="0,16,0,0"
                               FontStyle="Italic">
                        The app will prompt you if elevation is needed for a specific action.
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <!-- Page 4: Complete -->
            <TabItem>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="You're All Set!"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,24"/>

                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="13" MaxWidth="400" LineHeight="22">
                        The application is running in the system tray. Right-click the tray icon for quick access to settings and process management.
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="12" MaxWidth="400" Margin="0,16,0,0"
                               FontStyle="Italic">
                        You can change any of these settings later from the Settings window.
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Page Indicator -->
            <TextBlock x:Name="PageIndicator"
                       Grid.Column="0"
                       Text="Step 1 of 4"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       FontSize="12"/>

            <Button x:Name="BackButton"
                    Grid.Column="2"
                    Content="Back"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Click="OnBackClicked"
                    Visibility="Collapsed"
                    Style="{DynamicResource SecondaryButtonStyle}"/>

            <Button x:Name="NextButton"
                    Grid.Column="3"
                    Content="Next"
                    Padding="16,8"
                    Click="OnNextClicked"
                    Style="{DynamicResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
