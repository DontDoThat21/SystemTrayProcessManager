<Window x:Class="SystemTrayProcessManager.UI.Views.HotkeyConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SystemTrayProcessManager.UI.Controls"
        xmlns:vm="clr-namespace:SystemTrayProcessManager.UI.ViewModels"
        xmlns:local="clr-namespace:SystemTrayProcessManager.UI.Views"
        mc:Ignorable="d"
        Title="Hotkey Configuration"
        Height="650" 
        Width="850"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DarkWindowStyle}"
        d:DataContext="{d:DesignInstance Type=vm:HotkeyConfigViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <!-- Style for section headers -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Style for the edit panel -->
        <Style x:Key="EditPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <!-- Style for form labels -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Hotkey Configuration" 
                       FontSize="20" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="Choose an action and target application, record a shortcut, then Save &amp; Apply. Changes take effect immediately."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hotkey List -->
            <DataGrid x:Name="HotkeyGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding HotkeyItems}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource CardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      RowBackground="{DynamicResource CardBrush}"
                      AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                      RowHeight="35">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Enabled Column -->
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="Enable/Disable this hotkey"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name Column -->
                    <DataGridTextColumn Header="Name" 
                                        Binding="{Binding Name}" 
                                        Width="*"
                                        MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Hotkey Column -->
                    <DataGridTextColumn Header="Hotkey" 
                                        Binding="{Binding DisplayString}" 
                                        Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Action Column -->
                    <DataGridTextColumn Header="Action" 
                                        Binding="{Binding ActionType}" 
                                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Target Column -->
                    <DataGridTextColumn Header="Target" 
                                        Binding="{Binding TargetProcessName, TargetNullValue='Focused Window'}" 
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" 
                                            ToolTip="Edit"
                                            Command="{Binding DataContext.EditHotkeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource IconButtonStyle}"
                                            Width="28" Height="28"
                                            FontSize="13"/>
                                    <Button Content="🗑️" 
                                            ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteHotkeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource IconButtonStyle}"
                                            Width="28" Height="28"
                                            FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Edit Panel -->
            <Border Grid.Row="1" 
                    Style="{StaticResource EditPanelStyle}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Section Header -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                               Text="{Binding IsAddingNew, Converter={x:Static local:BoolToAddEditConverter.Instance}}"
                               Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Name Field -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="Name:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             Text="{Binding EditingItem.Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}"
                             Margin="0,5"/>

                    <!-- Hotkey Capture -->
                    <TextBlock Grid.Row="1" Grid.Column="2" 
                               Text="Hotkey:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <controls:HotkeyCaptureBox x:Name="HotkeyCaptureControl"
                                               Grid.Row="1" Grid.Column="3"
                                               VirtualKeyCode="{Binding EditingItem.VirtualKeyCode, Mode=TwoWay}"
                                               Modifiers="{Binding EditingItem.Modifiers, Mode=TwoWay}"
                                               Margin="0,5"
                                               Height="30"
                                               GotKeyboardFocus="HotkeyCaptureControl_GotKeyboardFocus"
                                               LostKeyboardFocus="HotkeyCaptureControl_LostKeyboardFocus"
                                               HotkeyCaptured="HotkeyCaptureControl_HotkeyCaptured"/>

                    <!-- Action Type -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="Action:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding ActionTypes}"
                              SelectedItem="{Binding EditingItem.ActionType}"
                              Margin="0,5"/>

                    <!-- Target Process (Optional) -->
                    <TextBlock Grid.Row="2" Grid.Column="2" 
                               Text="Target:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="3"
                             Text="{Binding EditingItem.TargetProcessName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}"
                             Margin="0,5"
                             ToolTip="Application process name, such as Spotify or chrome.exe. Leave empty to target the focused window."/>

                    <!-- Description -->
                    <TextBlock Grid.Row="3" Grid.Column="0" 
                               Text="Description:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding EditingItem.Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}"
                             Margin="0,5"/>

                    <!-- Validation Message -->
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="4"
                               Text="{Binding ValidationMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibilityConverter}}"
                               Margin="0,5"/>

                    <!-- Conflict Warning -->
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="4"
                               Text="{Binding ConflictWarning}"
                               Foreground="{DynamicResource WarningBrush}"
                               Visibility="{Binding ConflictWarning, Converter={StaticResource NullToVisibilityConverter}}"
                               Margin="0,5"/>

                    <!-- Edit Buttons -->
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="4" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelEditCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="12,6"
                                Margin="5,0"/>
                        <Button Content="Save &amp; Apply"
                                Command="{Binding SaveEditCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="12,6"
                                Margin="5,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    Margin="0,15,0,10">
            <Button Content="➕ Add" 
                    Command="{Binding AddHotkeyCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="12,6" Margin="5,0"/>
            <Button Content="📥 Import" 
                    Command="{Binding ImportConfigurationCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="12,6" Margin="5,0"/>
            <Button Content="📤 Export" 
                    Command="{Binding ExportConfigurationCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="12,6" Margin="5,0"/>
            <Button Content="🔄 Reset to Defaults" 
                    Command="{Binding ResetToDefaultsCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Padding="12,6" Margin="5,0"/>

            <Separator Width="20" Visibility="Hidden"/>

            <Button Content="💾 Save Changes"
                    Command="{Binding SaveAllChangesCommand}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Padding="12,6" Margin="5,0"/>
        </StackPanel>

        <!-- Footer / Status -->
        <Border Grid.Row="3" 
                Style="{DynamicResource StatusBarStyle}"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{DynamicResource StatusBarTextStyle}"/>

                <!-- Close Button -->
                <Button Grid.Column="1"
                        Content="Close"
                        Click="CloseButton_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="20,6"
                        MinWidth="100"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="4"
                Background="#AA1E1E1E"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="{DynamicResource PrimaryBrush}"
                             Background="{DynamicResource SurfaceBrush}"/>
                <TextBlock Text="Please wait..." 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
