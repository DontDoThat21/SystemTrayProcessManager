<Window x:Class="SystemTrayProcessManager.UI.Views.HotkeyConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:SystemTrayProcessManager.UI.Controls"
        xmlns:vm="clr-namespace:SystemTrayProcessManager.UI.ViewModels"
        xmlns:local="clr-namespace:SystemTrayProcessManager.UI.Views"
        mc:Ignorable="d"
        Title="Hotkey Configuration"
        Height="650" 
        Width="850"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=vm:HotkeyConfigViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <!-- Converter for boolean to visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Style for section headers -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Style for buttons -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <!-- Style for the edit panel -->
        <Style x:Key="EditPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <!-- Style for form labels -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Hotkey Configuration" 
                       FontSize="20" 
                       FontWeight="Bold"
                       Foreground="#0078D4"/>
            <TextBlock Text="Manage keyboard shortcuts for process actions"
                       FontSize="12"
                       Foreground="#666"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hotkey List -->
            <DataGrid x:Name="HotkeyGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding HotkeyItems}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="#CCC"
                      Background="White"
                      RowHeight="35">

                <DataGrid.Columns>
                    <!-- Enabled Column -->
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="Enable/Disable this hotkey"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name Column -->
                    <DataGridTextColumn Header="Name" 
                                        Binding="{Binding Name}" 
                                        Width="*"
                                        MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Hotkey Column -->
                    <DataGridTextColumn Header="Hotkey" 
                                        Binding="{Binding DisplayString}" 
                                        Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Action Column -->
                    <DataGridTextColumn Header="Action" 
                                        Binding="{Binding ActionType}" 
                                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Target Column -->
                    <DataGridTextColumn Header="Target" 
                                        Binding="{Binding TargetProcessName, TargetNullValue='Focused Window'}" 
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#666"/>
                                <Setter Property="FontStyle" Value="Italic"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Actions Column -->
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" 
                                            ToolTip="Edit"
                                            Command="{Binding DataContext.EditHotkeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="5,2"
                                            Cursor="Hand"/>
                                    <Button Content="🗑️" 
                                            ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteHotkeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="5,2"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Edit Panel -->
            <Border Grid.Row="1" 
                    Style="{StaticResource EditPanelStyle}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Section Header -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                               Text="{Binding IsAddingNew, Converter={x:Static local:BoolToAddEditConverter.Instance}}"
                               Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Name Field -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="Name:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             Text="{Binding EditingItem.Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5"/>

                    <!-- Hotkey Capture -->
                    <TextBlock Grid.Row="1" Grid.Column="2" 
                               Text="Hotkey:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <controls:HotkeyCaptureBox x:Name="HotkeyCaptureControl"
                                               Grid.Row="1" Grid.Column="3"
                                               VirtualKeyCode="{Binding EditingItem.VirtualKeyCode, Mode=TwoWay}"
                                               Modifiers="{Binding EditingItem.Modifiers, Mode=TwoWay}"
                                               Margin="0,5"
                                               Height="30"
                                               HotkeyCaptured="HotkeyCaptureControl_HotkeyCaptured"/>

                    <!-- Action Type -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="Action:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding ActionTypes}"
                              SelectedItem="{Binding EditingItem.ActionType}"
                              Margin="0,5"/>

                    <!-- Target Process (Optional) -->
                    <TextBlock Grid.Row="2" Grid.Column="2" 
                               Text="Target:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="3"
                             Text="{Binding EditingItem.TargetProcessName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5"
                             ToolTip="Leave empty for focused window"/>

                    <!-- Description -->
                    <TextBlock Grid.Row="3" Grid.Column="0" 
                               Text="Description:" 
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding EditingItem.Description, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5"/>

                    <!-- Validation Message -->
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="4"
                               Text="{Binding ValidationMessage}"
                               Foreground="Red"
                               Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibilityConverter}}"
                               Margin="0,5"/>

                    <!-- Conflict Warning -->
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="4"
                               Text="{Binding ConflictWarning}"
                               Foreground="#CC7700"
                               Visibility="{Binding ConflictWarning, Converter={StaticResource NullToVisibilityConverter}}"
                               Margin="0,5"/>

                    <!-- Edit Buttons -->
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="4" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Save"
                                Command="{Binding SaveEditCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#0078D4"
                                Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    Margin="0,15,0,10">
            <Button Content="➕ Add" 
                    Command="{Binding AddHotkeyCommand}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="📥 Import" 
                    Command="{Binding ImportConfigurationCommand}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="📤 Export" 
                    Command="{Binding ExportConfigurationCommand}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="🔄 Reset to Defaults" 
                    Command="{Binding ResetToDefaultsCommand}"
                    Style="{StaticResource ActionButtonStyle}"/>

            <Separator Width="20" Visibility="Hidden"/>

            <Button Content="💾 Save Changes"
                    Command="{Binding SaveAllChangesCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#28A745"
                    Foreground="White"
                    FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Footer / Status -->
        <Border Grid.Row="3" 
                Background="#F0F0F0" 
                Padding="10,8"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#666"
                           VerticalAlignment="Center"/>

                <!-- Close Button -->
                <Button Grid.Column="1"
                        Content="Close"
                        Click="CloseButton_Click"
                        Padding="20,6"
                        MinWidth="100"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="4"
                Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="Please wait..." 
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
