<Window x:Class="SystemTrayProcessManager.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Height="600" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{DynamicResource DarkWindowStyle}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Tab Control -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}">

            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Startup" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <CheckBox Content="Start with Windows"
                                  IsChecked="{Binding StartWithWindows}"
                                  Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Text="Appears in Task Manager → Startup apps. Requires an installed or published copy."
                                   TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <CheckBox Content="Start minimized to system tray"
                                  IsChecked="{Binding StartMinimized}"
                                  Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Separator Margin="0,12" Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Behavior" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <CheckBox Content="Enable notifications"
                                  IsChecked="{Binding EnableNotifications}"
                                  Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <CheckBox Content="Minimize to system tray (instead of taskbar)"
                                  IsChecked="{Binding MinimizeToTray}"
                                  Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Separator Margin="0,12" Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Process Monitoring" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Refresh interval:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,8,0"/>
                            <Slider Value="{Binding ProcessRefreshIntervalMs}"
                                    Minimum="1000" Maximum="30000"
                                    TickFrequency="1000"
                                    IsSnapToTickEnabled="True"
                                    Width="200"
                                    VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding ProcessRefreshIntervalMs, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                <Run Text="ms"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys Tab -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Global Hotkeys" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <CheckBox Content="Enable global hotkeys"
                                  IsChecked="{Binding HotkeysEnabled}"
                                  Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Text="When enabled, registered hotkey combinations will work system-wide, even when other applications are focused."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   FontSize="12"/>

                        <TextBlock Text="To configure individual hotkey bindings, use the Hotkey Configuration window (accessible from the system tray menu)."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio Tab -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Audio Defaults" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Default volume:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,8,0"/>
                            <Slider Value="{Binding DefaultVolume}"
                                    Minimum="0" Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Width="200"
                                    VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="{Binding DefaultVolume, Mode=OneWay, StringFormat=P0}"/>
                            </TextBlock>
                        </StackPanel>

                        <Separator Margin="0,12" Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Behavior" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <CheckBox Content="Auto-mute processes when minimized"
                                  IsChecked="{Binding MuteOnMinimize}"
                                  Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance Tab -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Theme:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding Theme}"
                                      Width="150"/>
                        </StackPanel>

                        <Separator Margin="0,12" Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Display" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <CheckBox Content="Show process icons"
                                  IsChecked="{Binding ShowProcessIcons}"
                                  Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <CheckBox Content="Enable animations"
                                  IsChecked="{Binding AnimationsEnabled}"
                                  Margin="0,4"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,8,0,4"/>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left-aligned: Import/Export -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Import..."
                        Command="{Binding ImportSettingsCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        ToolTip="Import settings from a JSON file"
                        Style="{DynamicResource SecondaryButtonStyle}"/>

                <Button Content="Export..."
                        Command="{Binding ExportSettingsCommand}"
                        Padding="12,6"
                        ToolTip="Export current settings to a JSON file"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
            </StackPanel>

            <!-- Right-aligned: Reset, Restore, Cancel, Save -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Reset Defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Style="{DynamicResource DangerButtonStyle}"/>

                <Button Content="Restore Backup"
                        Command="{Binding RestoreFromBackupCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"/>

                <Button Content="Cancel"
                        Command="{Binding CancelChangesCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        IsCancel="True"/>

                <Button Content="Save"
                        Command="{Binding SaveAndCloseCommand}"
                        Padding="12,6"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
