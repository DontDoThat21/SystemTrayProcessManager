<Window x:Class="SystemTrayProcessManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemTrayProcessManager.UI"
        mc:Ignorable="d"
        Title="SystemTray Process Manager" 
        Height="600" 
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20">
            <TextBlock Text="SystemTray Process Manager" 
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Main Content -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
            <TextBlock Text="🎉 System Tray Integration Complete!"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       Foreground="#333"/>
            <TextBlock Text="Try the following:"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       Foreground="#666"/>
            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                <TextBlock Text="• Minimize this window to hide to system tray" 
                           FontSize="14" Foreground="#444" Margin="0,5"/>
                <TextBlock Text="• Click the tray icon to restore the window" 
                           FontSize="14" Foreground="#444" Margin="0,5"/>
                <TextBlock Text="• Right-click the tray icon for context menu" 
                           FontSize="14" Foreground="#444" Margin="0,5"/>
                <TextBlock Text="• Select 'Exit' from the tray menu to close" 
                           FontSize="14" Foreground="#444" Margin="0,5"/>
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10">
            <TextBlock Text="Phase 1 - Task 2: System Tray Integration ✅"
                       FontSize="12"
                       Foreground="#888"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
