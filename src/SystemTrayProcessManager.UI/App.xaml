<Application x:Class="SystemTrayProcessManager.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SystemTrayProcessManager.UI.Views"
             xmlns:converters="clr-namespace:SystemTrayProcessManager.UI.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme (must be loaded first as other styles reference theme brushes) -->
                <ResourceDictionary Source="Resources/Themes/DarkTheme.xaml"/>
                <!-- Styles -->
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Resources/Styles/WindowStyles.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ProcessCardStyle.xaml"/>
                <!-- Control Styles -->
                <ResourceDictionary Source="Resources/Styles/HotkeyCaptureBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Application-wide converters -->
            <views:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <converters:BoolToMuteIconConverter x:Key="BoolToMuteIconConverter"/>
            <converters:NotificationLevelToBrushConverter x:Key="NotificationLevelToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
