<UserControl x:Class="SystemTrayProcessManager.UI.Controls.NotificationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SystemTrayProcessManager.UI.Converters"
             MaxWidth="350"
             MinWidth="280">

    <UserControl.Resources>
        <converters:NotificationLevelToBrushConverter x:Key="LevelToBrushConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Padding="12,8"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="Notifications" 
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource FontSizeNormal}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            Content="Clear All"
                            Style="{DynamicResource IconButtonStyle}"
                            Width="Auto" Height="Auto"
                            Padding="8,4"
                            FontSize="{DynamicResource FontSizeSmall}"
                            Command="{Binding DataContext.DismissAllNotificationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Notification List -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="300">
                <ItemsControl ItemsSource="{Binding DataContext.Notifications, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="NotifBorder"
                                    Padding="12,8" 
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Level Indicator -->
                                    <Border Grid.Column="0" 
                                            Width="4" 
                                            CornerRadius="2"
                                            Margin="0,0,8,0"
                                            Background="{Binding Level, Converter={StaticResource LevelToBrushConverter}}"/>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Message}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding TimeAgo}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Dismiss button -->
                                    <Button Grid.Column="2"
                                            Style="{DynamicResource IconButtonStyle}"
                                            Content="&#x2715;"
                                            Width="24" Height="24"
                                            FontSize="10"
                                            Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="NotifBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NotifBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty State -->
            <TextBlock Grid.Row="1"
                       Text="No notifications"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,20"
                       Visibility="{Binding DataContext.HasNotifications, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}"/>
        </Grid>
    </Border>
</UserControl>
