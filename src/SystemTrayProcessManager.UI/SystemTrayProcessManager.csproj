<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SystemTrayProcessManager</AssemblyName>
    <RootNamespace>SystemTrayProcessManager.UI</RootNamespace>

    <!-- Version Information -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Product Information -->
    <Product>SystemTray Process Manager</Product>
    <Company>Portfolio Project</Company>
    <Authors>DontDoThat21</Authors>
    <Copyright>Copyright 2026</Copyright>
    <Description>Advanced Windows process management with global hotkeys, per-process audio control, and window manipulation.</Description>

    <!-- Publishing Options -->
    <RepositoryUrl>https://github.com/DontDoThat21/SystemTrayProcessManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.*,)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[8.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="[8.*,)" />
    <PackageReference Include="Serilog" Version="[3.*,)" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="[8.*,)" />
    <PackageReference Include="Serilog.Sinks.File" Version="[5.*,)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystemTrayProcessManager.Infrastructure\SystemTrayProcessManager.Infrastructure.csproj" />
    <ProjectReference Include="..\SystemTrayProcessManager.Core\SystemTrayProcessManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Icons\" />
    <Folder Include="Resources\Themes\" />
    <Folder Include="Services\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SystemTrayProcessManager.Tests" />
  </ItemGroup>

</Project>
